@component-name = "portal-frontend-infrastructure"
definition {

	property osgi.modules.includes = "frontend-taglib-clay-sample-web";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.component.names = "Clay";
	property testray.main.component.name = "User Interface";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		JSONLayout.addPublicLayout(
			groupName = "Guest",
			layoutName = "Clay Sample Test Page");

		JSONLayout.updateLayoutTemplateOfPublicLayout(
			groupName = "Guest",
			layoutName = "Clay Sample Test Page",
			layoutTemplate = "1 Column");

		JSONLayout.addWidgetToPublicLayout(
			groupName = "Guest",
			layoutName = "Clay Sample Test Page",
			widgetName = "Clay Sample");

		Navigator.gotoPage(pageName = "Clay Sample Test Page");
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			JSONLayout.deletePublicLayout(
				groupName = "Guest",
				layoutName = "Clay Sample Test Page");
		}
	}

	@description = "Test Ocular method"
	@priority = "3"
	test Smoke {
		task ("Take a screenshot of Alerts tab") {
			Navigator.gotoNavTab(navTab = "Alerts");

			OcularAssertElementImage(
				locator1="ClaySamplePortlet#ACTIVE_TAB_CONTENT",
				value1="portal/screenshots/claysample/alerts/content"
			);
		}

		task ("Take a screenshot of Badges tab") {
			Navigator.gotoNavTab(navTab = "Badges");

			OcularAssertElementImage(
				locator1="ClaySamplePortlet#ACTIVE_TAB_CONTENT",
				value1="portal/screenshots/claysample/badges/content"
			);
		}

		task ("Take a screenshot of Buttons tab") {
			Navigator.gotoNavTab(navTab = "Buttons");

			OcularAssertElementImage(
				locator1="ClaySamplePortlet#ACTIVE_TAB_CONTENT",
				value1="portal/screenshots/claysample/buttons/content"
			);
		}

		task ("Take a screenshot of Cards tab") {
			Navigator.gotoNavTab(navTab = "Cards");

			OcularAssertElementImage(
				locator1="ClaySamplePortlet#ACTIVE_TAB_CONTENT",
				value1="portal/screenshots/claysample/cards/content"
			);
		}

		task ("Take a screenshot of Dropdowns tab") {
			Navigator.gotoNavTab(navTab = "Dropdowns");

			OcularAssertElementImage(
				locator1="ClaySamplePortlet#ACTIVE_TAB_CONTENT",
				value1="portal/screenshots/claysample/dropdowns/content"
			);
		}

		task ("Take a screenshot of Form tab") {
			Navigator.gotoNavTab(navTab = "Form");

			OcularAssertElementImage(
				locator1="ClaySamplePortlet#ACTIVE_TAB_CONTENT",
				value1="portal/screenshots/claysample/form/content"
			);
		}

		task ("Take a screenshot of Icons tab") {
			Navigator.gotoNavTab(navTab = "Icons");

			OcularAssertElementImage(
				locator1="ClaySamplePortlet#ACTIVE_TAB_CONTENT",
				value1="portal/screenshots/claysample/icons/content"
			);
		}

		task ("Take a screenshot of Labels tab") {
			Navigator.gotoNavTab(navTab = "Labels");

			OcularAssertElementImage(
				locator1="ClaySamplePortlet#ACTIVE_TAB_CONTENT",
				value1="portal/screenshots/claysample/labels/content"
			);
		}

		task ("Take a screenshot of Links tab") {
			Navigator.gotoNavTab(navTab = "Links");

			OcularAssertElementImage(
				locator1="ClaySamplePortlet#ACTIVE_TAB_CONTENT",
				value1="portal/screenshots/claysample/links/content"
			);
		}

		task ("Take a screenshot of Management Toolbars tab") {
			Navigator.gotoNavTab(navTab = "Management Toolbars");

			OcularAssertElementImage(
				locator1="ClaySamplePortlet#ACTIVE_TAB_CONTENT",
				value1="portal/screenshots/claysample/managementtoolbars/content"
			);
		}

		task ("Take a screenshot of Navigation Bars tab") {
			Navigator.gotoNavTab(navTab = "Navigation Bars");

			OcularAssertElementImage(
				locator1="ClaySamplePortlet#ACTIVE_TAB_CONTENT",
				value1="portal/screenshots/claysample/navigationbars/content"
			);
		}

		task ("Take a screenshot of Pagination Bars tab") {
			Navigator.gotoNavTab(navTab = "Pagination Bars");

			OcularAssertElementImage(
				locator1="ClaySamplePortlet#ACTIVE_TAB_CONTENT",
				value1="portal/screenshots/claysample/paginationbars/content"
			);
		}

		task ("Take a screenshot of Progress Bars tab") {
			Navigator.gotoNavTab(navTab = "Progress Bars");

			OcularAssertElementImage(
				locator1="ClaySamplePortlet#ACTIVE_TAB_CONTENT",
				value1="portal/screenshots/claysample/progressbars/content"
			);
		}

		task ("Take a screenshot of Stickers tab") {
			Navigator.gotoNavTab(navTab = "Stickers");

			OcularAssertElementImage(
				locator1="ClaySamplePortlet#ACTIVE_TAB_CONTENT",
				value1="portal/screenshots/claysample/stickers/content"
			);
		}
	}

}