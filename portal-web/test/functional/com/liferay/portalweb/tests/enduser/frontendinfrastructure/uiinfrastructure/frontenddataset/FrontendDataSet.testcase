@component-name = "portal-frontend-infrastructure"
definition {

	property osgi.modules.includes = "frontend-data-set-sample-web";
	property portal.acceptance = "john-co";
	property portal.release = "false";
	property portal.upstream = "true";
	property testray.component.names = "Frontend Dataset";
	property testray.main.component.name = "User Interface";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		JSONLayout.addPublicLayout(
			groupName = "Guest",
			layoutName = "Frontend Data Set Test Page");

		JSONLayout.updateLayoutTemplateOfPublicLayout(
			groupName = "Guest",
			layoutName = "Frontend Data Set Test Page",
			layoutTemplate = "1 Column");

		JSONLayout.addWidgetToPublicLayout(
			groupName = "Guest",
			layoutName = "Frontend Data Set Test Page",
			widgetName = "Frontend Data Set Sample");

		Navigator.gotoPage(pageName = "Frontend Data Set Test Page");

		takeScreenshot();

		Pause(locator1 = "5000");

		takeScreenshot();

		Pause(locator1 = "15000");

		takeScreenshot();

		Pause(locator1 = "30000");

		takeScreenshot();

		Refresh();

		Pause(locator1 = "5000");

		takeScreenshot();

		Pause(locator1 = "15000");

		takeScreenshot();

		Pause(locator1 = "30000");

		// var iterator = "0";
		// var maxRetryNumber = "3";

		// while ((IsElementNotPresent(
		// 	key_itemName = "Sample1",
		// 	locator1 = "FrontendDataSet#TABLE_ITEM_ROW")) && ("${iterator}" != "${maxRetryNumber}")) {
		// 		takeScreenshot();

		// 		Refresh();

		// 		Pause(locator1 = "5000");
		// }

		// while ((IsElementNotPresent(
		// 	key_itemName = "Sample1",
		// 	locator1 = "FrontendDataSet#TABLE_ITEM_ROW")) && ("${iterator}" != "${maxRetryNumber}")) {
		// 		takeScreenshot();

		// 		Refresh();

		// 		Pause(locator1 = "15000");
		// }

		// while ((IsElementNotPresent(
		// 	key_itemName = "Sample1",
		// 	locator1 = "FrontendDataSet#TABLE_ITEM_ROW")) && ("${iterator}" != "${maxRetryNumber}")) {
		// 		takeScreenshot();

		// 		Refresh();

		// 		Pause(locator1 = "30000");
		// }
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			JSONLayout.deletePublicLayout(
				groupName = "Guest",
				layoutName = "Frontend Data Set Test Page");
		}
	}

	@description = "LPS-147914: Verify alert message is present when action button is clicked"
	@priority = "4"
	test ActionsCanBeCustomized {
		task ("When Click on 1st action button in FDS sample") {
			MouseOver(
				key_itemName = "Sample1",
				locator1 = "FrontendDataSet#TABLE_ITEM_ROW");

			ClickNoError(
				key_title = "Sample1",
				locator1 = "FrontendDataSet#VIEW_ACTION_BUTTON");
		}

		task ("Then 1st alert message is present") {
			AssertConfirm.assertConfirmationNoError(value1 = "Hello Sample1!");
		}

		task ("When Click on 2st action button in FDS sample") {
			MouseOver(
				key_itemName = "Sample2",
				locator1 = "FrontendDataSet#TABLE_ITEM_ROW");

			ClickNoError(
				key_title = "Sample2",
				locator1 = "FrontendDataSet#VIEW_ACTION_BUTTON");
		}

		task ("Then 2st alert message is present") {
			AssertConfirm.assertConfirmationNoError(value1 = "Hello Sample2!");
		}
	}

}