@component-name = "portal-frontend-infrastructure"
definition {

	property portal.release = "true";
	property portal.upstream = "true";
	property testray.component.names = "Accessibility";
	property testray.main.component.name = "User Interface";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@description = "Verify poshi function AssertAccessible passes atleast one portal page based on WCAG 2.0 AA standards"
	@priority = "5"
	test CanAssertAccessible {
		property portal.acceptance = "true";

		AssertAccessible();

		SignOut.signOut();

		AssertAccessible();
	}

	@description = "Verify poshi function AssertAccessible can fail a page that has a WCAG 2.0 AA violation"
	@ignore = "Test Stub"
	@priority = "5"
	test CanAssertNotAccessible {
		property osgi.modules.includes = "frontend-js-a11y-sample-web";
		property portal.acceptance = "false";

		task ("Given frontend js a11y sample portlet on a page") {
			JSONLayout.addPublicLayout(
				groupName = "Guest",
				layoutName = "A11y Test Page");

			JSONLayout.addWidgetToPublicLayout(
				groupName = "Guest",
				layoutName = "A11y Test Page",
				widgetName = "JS A11y Sample");

			JSONLayout.updateLayoutTemplateOfPublicLayout(
				groupName = "Guest",
				layoutName = "A11y Test Page",
				layoutTemplate = "1 Column");

			Navigator.gotoPage(pageName = "A11y Test Page");
		}

		task ("And Given an accessibility violation is present") {
			VerifyElementPresent(
				key_index = "1",
				locator1 = "A11yTool#PORTLET_HEADER");
		}

		task ("When checking if accessibility violation is present") {
			AssertNotAccessible();
		}

		task ("Then violation is thrown") {
		}
	}

}