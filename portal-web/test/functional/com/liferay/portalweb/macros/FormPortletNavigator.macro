definition {

	macro gotoSelectForm {
		AssertClick(
			locator1 = "FormPortlet#SELECT_FORM",
			value1 = "Select Form");

		WaitForLiferayEvent(
			attributeName = "src",
			attributeValue = "dialog-iframe-popup",
			eventName = "modalIframeLoaded");

		SelectFrame(locator1 = "IFrame#MODAL_BODY");
	}

}