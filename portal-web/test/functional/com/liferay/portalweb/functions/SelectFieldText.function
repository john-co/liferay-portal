@default = "selectFieldText"
@summary = "Selecting all text at '${locator1}'"
definition {

	function selectFieldText {
		WaitForSPARefresh();

		Click();

		selenium.selectFieldText();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function selectFieldTextCopy {
		WaitForSPARefresh();

		Click();

		selenium.selectFieldTextCopy();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function selectFieldTextPaste {
		WaitForSPARefresh();

		Click();

		selenium.selectFieldTextPaste();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

}