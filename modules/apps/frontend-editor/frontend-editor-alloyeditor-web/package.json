{
	"csfConfig": {
		"js": {
			"lint": {
				"globals": {
					"AlloyEditor": true,
					"MODULE_PATH": true
				},
				"rules": {
					"consistent-return": 0
				}
			}
		},
		"path:**/test/**/*.js": {
			"js": {
				"lint": {
					"env": {
						"jest": true
					},
					"rules": {
						"global-require": 0
					}
				}
			}
		}
	},
	"dependencies": {
		"alloyeditor": "^1.5.18",
		"liferay-module-config-generator": "^1.3.3"
	},
	"devDependencies": {
		"babel-loader": "^7.1.2",
		"babel-preset-react": "^6.24.1",
		"liferay-npm-scripts": "1.2.0",
		"webpack": "^3.10.0",
		"webpack-dev-server": "^2.11.1",
		"webpack-merge": "^4.1.1"
	},
	"jest": {
		"globals": {
			"CKEDITOR": {},
			"Liferay": {}
		},
		"testMatch": [
			"**/test/**/*.js"
		],
		"testResultsProcessor": "./node_modules/liferay-jest-junit-reporter",
		"testURL": "http://localhost"
	},
	"name": "frontend-editor-alloyeditor-web",
	"scripts": {
		"csf": "liferay-npm-scripts lint",
		"format": "liferay-npm-scripts format",
		"start": "webpack-dev-server --config webpack.dev.js",
		"test": "liferay-npm-scripts test",
		"webpack": "webpack --config webpack.prod.js",
		"webpack:dev": "webpack --config webpack.dev.js"
	},
	"version": "3.0.0"
}
